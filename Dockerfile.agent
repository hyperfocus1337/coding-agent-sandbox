# syntax=docker/dockerfile:1
# Top layer: script/curl-based AI agent installers + agent config, on top of the
# python devcontainer image (which now also carries the Playwright browser stack).
# This is the image the devcontainer runs. The npm-based agent CLIs (sandbox-runtime,
# Codex, Gemini, OpenCode, Duo) live in Dockerfile.node; only installers that are not
# npm packages live here, so an agent-CLI bump that only touches this layer does not
# rebuild the layers below.

ARG BASE_IMAGE=ghcr.io/hyperfocus1337/coding-agent-sandbox/devcontainer-python:latest
FROM ${BASE_IMAGE}

# Base image declares ARG USERNAME=node but does not export it as ENV, so re-declare here.
ARG USERNAME=node

# ----- Script-based AI installers and agent config -----
USER $USERNAME

# Install Claude Code CLI official installation script
# https://code.claude.com/docs/en/setup
RUN curl -fsSL https://claude.ai/install.sh | bash

# Install Tessl CLI
RUN curl -fsSL https://get.tessl.io | sh

# Install herdr CLI (integrations wire up Claude Code, installed above, and OpenCode,
# installed via npm in Dockerfile.node).
# https://herdr.dev/docs/install/
RUN curl -fsSL https://herdr.dev/install.sh | sh && \
    herdr integration install claude && \
    herdr integration install opencode

# Install Agent Package Manager (apm)
# https://microsoft.github.io/apm/
RUN curl -sSL https://aka.ms/apm-unix | APM_INSTALL_DIR="$HOME/.local/bin" sh

# Personal Git identity is NOT baked in. It is injected at runtime via a
# docker-compose.override.yml bind mount (config/.gitconfig → ~/.gitconfig); see the .example.

# Agent helper scripts (config.sh applies dotfiles via chezmoi/just, both from lower layers).
# Commented for now, the home folder is mounted as a volume thus any changes get overwritten on container start.
# COPY --chown=$USERNAME:$USERNAME scripts/agents/ /home/$USERNAME/scripts/agents/

# Install agent dependencies
# RUN bash /home/$USERNAME/scripts/agents/config.sh

# Install Gemini extensions
# RUN bash /home/$USERNAME/scripts/agents/gemini.sh
