# ShellCheck config for the version-management scripts.
# These two are inherent to how the scripts are structured, not code smells:

# manifest.sh sets metadata variables (KIND, URL_TMPL, ...) for callers to read
# after sourcing it; they are intentionally never used within manifest.sh itself.
disable=SC2034

# install.sh and resolve.sh source sibling files (manifest.sh, versions.lock) by
# runtime path; ShellCheck cannot follow them statically during linting.
disable=SC1091
