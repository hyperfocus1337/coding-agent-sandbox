# syntax=docker/dockerfile:1
# Adds developer + AI tooling on top of the base devcontainer image.
# General developer tooling (GitHub CLI, GitLab CLI, git-delta, just, just-lsp) is installed
# first, then AI tooling (sandbox-runtime, Claude Code, Codex, Gemini, OpenCode,
# Tessl, plugins).
ARG BASE_IMAGE=ghcr.io/hyperfocus1337/coding-agent-sandbox/devcontainer-base:latest
FROM ${BASE_IMAGE}

# Base image declares ARG USERNAME=node but does not export it as ENV, so re-declare here.
ARG USERNAME=node

# Numeric uid/gid for `--mount=type=cache,uid=,gid=` below — must match the non-root user
# so npm cache writes are owned correctly.
ARG USER_UID=1000
ARG USER_GID=1000

# Automatically set by BuildKit for multi-platform builds; used to scope apt caches per arch.
ARG TARGETARCH

# ===== General developer tooling =====

# ----- Root: system-wide installs (apt, dpkg, vendor scripts to /usr/local) -----
USER root

# Binary-tool installer: shared helper + manifest + pinned versions (versions.lock).
# COPY'd before first use so both the root-context and $USERNAME-context tool installs below
# can call `install-tool <name>`. Bumping versions.lock invalidates layers from here down (intended).
COPY scripts/versions/ /usr/local/share/tool-install/
COPY versions.lock /usr/local/share/tool-install/versions.lock
RUN chmod +x /usr/local/share/tool-install/install.sh \
    && ln -s /usr/local/share/tool-install/install.sh /usr/local/bin/install-tool

# Github CLI (apt from custom keyring).
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md#debian
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    (type -p wget >/dev/null || (apt update && apt install wget -y)) \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && out=$(mktemp) && wget -nv -O$out https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && cat $out | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && mkdir -p -m 755 /etc/apt/sources.list.d \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt update \
    && apt install gh -y

# GitLab CLI (glab). Version pinned in versions.lock.
# https://gitlab.com/gitlab-org/cli/-/releases
RUN install-tool glab

# Git Delta: pretty git diffs. Version pinned in versions.lock.
RUN install-tool git-delta

# Powerline fonts for shell prompts (glyphs used by powerline/starship/p10k themes).
# https://github.com/powerline/fonts
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y fonts-powerline

# shellcheck (shell script linter) and yamllint (YAML linter) from Debian repos.
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y shellcheck yamllint

# OpenTofu from the official apt repository (Debian/Ubuntu install method).
# https://opentofu.org/docs/intro/install/deb/
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    set -eu; \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://get.opentofu.org/opentofu.gpg -o /etc/apt/keyrings/opentofu.gpg && \
    curl -fsSL https://packages.opentofu.org/opentofu/tofu/gpgkey \
        | gpg --no-tty --batch --dearmor -o /etc/apt/keyrings/opentofu-repo.gpg && \
    chmod a+r /etc/apt/keyrings/opentofu.gpg /etc/apt/keyrings/opentofu-repo.gpg && \
    printf '%s\n%s\n' \
        "deb [signed-by=/etc/apt/keyrings/opentofu.gpg,/etc/apt/keyrings/opentofu-repo.gpg] https://packages.opentofu.org/opentofu/tofu/any/ any main" \
        "deb-src [signed-by=/etc/apt/keyrings/opentofu.gpg,/etc/apt/keyrings/opentofu-repo.gpg] https://packages.opentofu.org/opentofu/tofu/any/ any main" \
        > /etc/apt/sources.list.d/opentofu.list && \
    chmod a+r /etc/apt/sources.list.d/opentofu.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends tofu

# Azure CLI via official Microsoft install script (apt repo set up internally).
# https://learn.microsoft.com/en-us/cli/azure/install-azure-cli-linux?pivots=apt
# RUN curl -fsSL 'https://azurecliprod.blob.core.windows.net/$root/deb_install.sh' | bash

# AWS CLI v2 from the official AWS bundle (no apt package — vendor-recommended path).
# https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html
# RUN ARCH=$(uname -m) && \
#     curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${ARCH}.zip" -o /tmp/awscliv2.zip && \
#     unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/awscliv2.zip /tmp/aws

# ----- User: user-local binaries (~/.local/bin) and npm globals -----
USER $USERNAME

# just CLI. Version pinned in versions.lock.
RUN install-tool just

# just-lsp. Version pinned in versions.lock.
RUN install-tool just-lsp

# Terraform. Version pinned in versions.lock.
RUN install-tool terraform

# Oracle Cloud Infrastructure (OCI) CLI via official Oracle install script.
# https://docs.oracle.com/en-us/iaas/Content/API/SDKDocs/cliinstall.htm
# RUN bash -c "$(curl -fsSL https://raw.githubusercontent.com/oracle/oci-cli/master/scripts/install/install.sh)" -- --accept-all-defaults

# Prettier code formatter
RUN --mount=type=cache,target=/home/$USERNAME/.npm,uid=${USER_UID},gid=${USER_GID} \
    npm install -g prettier

# Markdownlint CLI v2
RUN --mount=type=cache,target=/home/$USERNAME/.npm,uid=${USER_UID},gid=${USER_GID} \
    npm install -g markdownlint-cli2

# ESLint (JavaScript/TypeScript linter)
RUN --mount=type=cache,target=/home/$USERNAME/.npm,uid=${USER_UID},gid=${USER_GID} \
    npm install -g eslint

# ===== AI tooling =====

# ----- Root: sandbox runtime system deps -----
USER root

# Claude Code sandbox runtime: apt sandbox deps (bubblewrap/socat/seccomp) as root.
# The npm CLI itself is installed below as $USERNAME so it writes into the user-owned
# npm-global prefix (running it as root would create root-owned subdirs under
# NPM_CONFIG_PREFIX and break subsequent user-side `npm install -g`).
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y bubblewrap socat seccomp

# ----- User: AI CLIs and agent config -----
USER $USERNAME

# Claude Code sandbox runtime (npm).
RUN --mount=type=cache,target=/home/$USERNAME/.npm,uid=${USER_UID},gid=${USER_GID} \
    npm install -g @anthropic-ai/sandbox-runtime

# Install Claude Code CLI official installation script
# https://code.claude.com/docs/en/setup
RUN curl -fsSL https://claude.ai/install.sh | bash

# Install Codex CLI
# https://developers.openai.com/codex/cli
RUN --mount=type=cache,target=/home/$USERNAME/.npm,uid=${USER_UID},gid=${USER_GID} \
    npm install -g @openai/codex

# Install Gemini CLI
# https://geminicli.com/docs/get-started/installation/
RUN --mount=type=cache,target=/home/$USERNAME/.npm,uid=${USER_UID},gid=${USER_GID} \
    npm install -g @google/gemini-cli

# Install OpenCode
# https://opencode.ai/docs/
RUN --mount=type=cache,target=/home/$USERNAME/.npm,uid=${USER_UID},gid=${USER_GID} \
    npm install -g opencode-ai

# Install Tessl CLI
RUN curl -fsSL https://get.tessl.io | sh

# Install herdr CLI
# https://herdr.dev/docs/install/
RUN curl -fsSL https://herdr.dev/install.sh | sh

# Personal Git identity (gitignored, not committed). Provide config/.gitconfig locally before building.
COPY --chown=$USERNAME:$USERNAME config/.gitconfig /home/$USERNAME/.gitconfig

# Agent helper scripts (claude.sh installs Claude Code plugins/MCP servers via the CLI installed above).
COPY --chown=$USERNAME:$USERNAME scripts/agents/ /home/$USERNAME/scripts/agents/

# Install Claude Code plugins and MCP servers
RUN bash /home/$USERNAME/scripts/agents/claude.sh

# Install Gemini extensions
# RUN bash /home/$USERNAME/scripts/agents/gemini.sh
