# syntax=docker/dockerfile:1
# Adds general (non-node) developer tooling on top of the node devcontainer image:
# GitHub CLI, GitLab CLI, OpenTofu, cloud CLIs (Azure/AWS), git-delta, just, just-lsp,
# gitleaks, betterleaks, chezmoi, git (built from the official source tarball, newer than
# trixie apt). Node packages live in Dockerfile.node; AI agent installers in Dockerfile.agent.
ARG BASE_IMAGE=ghcr.io/hyperfocus1337/coding-agent-sandbox/devcontainer-node:latest
FROM ${BASE_IMAGE}

# Base image declares ARG USERNAME=user but does not export it as ENV, so re-declare here.
ARG USERNAME=user

# Numeric uid/gid for `--mount=type=cache,uid=,gid=` below — must match the non-root user
# so npm cache writes are owned correctly.
ARG USER_UID=1000
ARG USER_GID=1000

# Automatically set by BuildKit for multi-platform builds; used to scope apt caches per arch.
ARG TARGETARCH

# ===== General developer tooling =====

# ----- Root: system-wide installs (apt, dpkg, vendor scripts to /usr/local) -----
USER root

# AI-agent CLI toolkit + general developer/network/data utilities, moved here from
# the base image to keep that layer a lean shell baseline. fd-find/bat install under
# Debian-specific binary names (fdfind/batcat); the symlinks expose fd/bat. shellcheck
# and yamllint (linters) install here too. See README.md ("apt packages").
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ripgrep \
    fd-find \
    bat \
    shellcheck \
    yamllint \
    universal-ctags \
    patch \
    patchutils \
    miller \
    csvkit \
    httpie \
    netcat-openbsd \
    socat \
    lsof \
    file \
    moreutils \
    ncdu \
    strace \
    rsync \
    wget \
    dnsutils \
    jq \
    tree \
    man-db \
    postgresql-client \
    sqlite3 && \
    ln -s "$(command -v fdfind)" /usr/local/bin/fd && \
    ln -s "$(command -v batcat)" /usr/local/bin/bat

# ===== git, built from the official upstream release tarball =====
#
# Why not apt: trixie caps at git 2.47.3, but worktree.useRelativePaths needs 2.48+ (without
# it a worktree created on the macOS host is unusable under /workspaces, since its .git file
# points at /Users/...). sid has 2.55.0 but depends on libcurl4-gnutls, which Breaks trixie's
# libcurl3t64-gnutls and would drop the libproxy/glib-networking/gstreamer chain with it.
# Why not mise: git publishes no release binaries (git.git has zero GitHub release assets and
# no aqua entry), so every mise backend would need a third-party plugin that compiles anyway.
#
# Everything git lives in this one block on purpose: build deps, tarball, build, man pages,
# purge. To bump: change GIT_VERSION and both hashes together, taking them from
# https://mirrors.edge.kernel.org/pub/software/scm/git/sha256sums.asc (signed by the git
# maintainer). --without-tcltk skips gitk/git-gui, so no tcl/tk; build-essential comes from
# the base image. The -dev packages are purged in the same layer, after apt-mark pins the
# runtime libs git links against (all five arrive as auto-installed deps, so --auto-remove
# would otherwise take them and break the binary).
#
# pcre2 is opt-in (`--with-libpcre2`), otherwise `git grep -P` is missing. The
# config.mak.autogen greps are not decoration: a missing header makes ./configure exit 0 and
# silently set NO_CURL/NO_EXPAT/NO_OPENSSL (or drop USE_LIBPCRE2), which yields a git with no
# https transport. Fail the build there instead of shipping that.
#
# NO_RUST=1 (both make calls, or install rebuilds the Rust lib) keeps cargo out of the build.
# In 2.55 the Rust code is only varint plus hash/loose/csum_file wrappers, and NO_RUST
# compiles the C varint.o instead, so nothing is lost. Git 3.0 makes Rust mandatory: add
# `cargo` to the deps above and drop both NO_RUST=1 when moving to it.
ARG GIT_VERSION=2.55.0
ARG GIT_SHA256=457fdb04dc8728e007d4688695e6912e6f680727920f2a40bf11eacc17505357
ARG GIT_MANPAGES_SHA256=a32d432f80df46a14a05d1104c72d5a13fe27e9feba9aa0f017e54131db6b982
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        gettext \
        libcurl4-openssl-dev \
        libexpat1-dev \
        zlib1g-dev \
        libssl-dev \
        libpcre2-dev; \
    apt-mark manual libcurl4t64 libexpat1 zlib1g libssl3t64 libpcre2-8-0; \
    mirror="https://mirrors.edge.kernel.org/pub/software/scm/git"; \
    cd /tmp; \
    curl -fsSLO "$mirror/git-${GIT_VERSION}.tar.xz"; \
    curl -fsSLO "$mirror/git-manpages-${GIT_VERSION}.tar.xz"; \
    echo "${GIT_SHA256}  git-${GIT_VERSION}.tar.xz" | sha256sum -c -; \
    echo "${GIT_MANPAGES_SHA256}  git-manpages-${GIT_VERSION}.tar.xz" | sha256sum -c -; \
    tar -xf "git-${GIT_VERSION}.tar.xz"; \
    cd "git-${GIT_VERSION}"; \
    ./configure --prefix=/usr/local --without-tcltk --with-libpcre2; \
    grep -q '^USE_LIBPCRE2=' config.mak.autogen; \
    ! grep -qE '^(NO_CURL|NO_EXPAT|NO_OPENSSL)=' config.mak.autogen; \
    make -j"$(nproc)" NO_RUST=1; \
    make install NO_RUST=1; \
    mkdir -p /usr/local/share/man; \
    tar -xf "/tmp/git-manpages-${GIT_VERSION}.tar.xz" -C /usr/local/share/man; \
    cd /; \
    rm -rf "/tmp/git-${GIT_VERSION}" /tmp/git-*.tar.xz; \
    apt-get purge -y --auto-remove \
        gettext \
        libcurl4-openssl-dev \
        libexpat1-dev \
        zlib1g-dev \
        libssl-dev \
        libpcre2-dev; \
    test "$(command -v git)" = /usr/local/bin/git; \
    test "$(git --version)" = "git version ${GIT_VERSION}"; \
    test -x /usr/local/libexec/git-core/git-remote-https; \
    test -f /usr/local/share/man/man1/git-init.1

# Github CLI (apt from custom keyring).
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md#debian
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    (type -p wget >/dev/null || (apt update && apt install wget -y)) \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && out=$(mktemp) && wget -nv -O$out https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && cat $out | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && mkdir -p -m 755 /etc/apt/sources.list.d \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt update \
    && apt install gh -y

# Powerline fonts for shell prompts (glyphs used by powerline/starship/p10k themes).
# https://github.com/powerline/fonts
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y fonts-powerline

# Chromium: the distro browser puppeteer-based tools (mermaid-cli in Dockerfile.node,
# chrome-devtools-mcp in Dockerfile.node) drive headlessly. Installed via apt so it is
# arch-correct (puppeteer's own download previously grabbed an amd64 binary on arm64 and
# crashed with "Dynamic loader not found: /lib64/ld-linux-x86-64.so.2"). The Debian package
# ships a SUID chrome-sandbox, so it runs headless as the non-root user WITHOUT --no-sandbox.
# PUPPETEER_EXECUTABLE_PATH points tools here; see Dockerfile.node. fonts-liberation covers
# common diagram/page text so rendered output is not tofu boxes.
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends chromium fonts-liberation

# OpenTofu from the official apt repository (Debian/Ubuntu install method).
# https://opentofu.org/docs/intro/install/deb/
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    set -eu; \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://get.opentofu.org/opentofu.gpg -o /etc/apt/keyrings/opentofu.gpg && \
    curl -fsSL https://packages.opentofu.org/opentofu/tofu/gpgkey \
        | gpg --no-tty --batch --dearmor -o /etc/apt/keyrings/opentofu-repo.gpg && \
    chmod a+r /etc/apt/keyrings/opentofu.gpg /etc/apt/keyrings/opentofu-repo.gpg && \
    printf '%s\n%s\n' \
        "deb [signed-by=/etc/apt/keyrings/opentofu.gpg,/etc/apt/keyrings/opentofu-repo.gpg] https://packages.opentofu.org/opentofu/tofu/any/ any main" \
        "deb-src [signed-by=/etc/apt/keyrings/opentofu.gpg,/etc/apt/keyrings/opentofu-repo.gpg] https://packages.opentofu.org/opentofu/tofu/any/ any main" \
        > /etc/apt/sources.list.d/opentofu.list && \
    chmod a+r /etc/apt/sources.list.d/opentofu.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends tofu

# Azure CLI via official Microsoft install script (apt repo set up internally).
# https://learn.microsoft.com/en-us/cli/azure/install-azure-cli-linux?pivots=apt
# Config file: ~/.azure/config — must be configured (e.g. `az login`) before usage is enabled.
RUN curl -fsSL 'https://azurecliprod.blob.core.windows.net/$root/deb_install.sh' | bash

# AWS CLI v2 from the official AWS bundle (no apt package — vendor-recommended path).
# https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html
# Config files: ~/.aws/config and ~/.aws/credentials — must be configured (e.g. `aws configure`) before usage is enabled.
RUN ARCH=$(uname -m) && \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${ARCH}.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/awscliv2.zip /tmp/aws

# ----- User: user-local binaries (~/.local/bin) -----
USER $USERNAME

# Pinned release binaries via mise. Versions come from the mise.toml baked into the
# base image. Short names resolve through mise's registry; git-delta uses its explicit
# aqua backend and just-lsp (not in the registry) uses the ubi GitHub-release backend,
# which downloads + extracts the release binary.
RUN mise install glab just terraform kubectl k3s aqua:dandavison/delta ubi:terror/just-lsp gitleaks betterleaks

# GitHub Stacked PRs (gh stack) extension: break large changes into small, stacked PRs.
# Installs into the user-owned gh extension dir (~/.local/share/gh). Requires the gh CLI above.
# https://github.github.com/gh-stack/
RUN gh extension install github/gh-stack

# Chezmoi: manage dotfiles across machines. Installer's default target is ./bin, so pin -b to
# the user-local bin dir already on PATH.
# https://www.chezmoi.io/install/
RUN sh -c "$(curl -fsLS https://get.chezmoi.io)" -- -b "$HOME/.local/bin"
