# syntax=docker/dockerfile:1
# https://hub.docker.com/_/debian
# Debian 13 (trixie), the current stable release. Node no longer comes from the
# base image; mise installs it (and every other language runtime) below.
FROM debian:trixie-slim

# Pass timezone as build argument
ARG TZ
ENV TZ="$TZ"

# Username for the non-root user
ARG USERNAME=node
ARG USER_UID=1000
ARG USER_GID=1000

# Automatically set by BuildKit for multi-platform builds; used to scope apt caches per arch
ARG TARGETARCH

# The node image used to provide this user; on a plain Debian base we create it
# ourselves so the uid/gid the devcontainer expects (1000:1000) exists.
RUN groupadd --gid "$USER_GID" "$USERNAME" \
    && useradd --uid "$USER_UID" --gid "$USER_GID" --create-home --shell /bin/bash "$USERNAME"

# Install basic development tools
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    less \
    git \
    procps \
    sudo \
    fzf \
    fish \
    man-db \
    unzip \
    ca-certificates \
    curl \
    gnupg \
    gnupg2 \
    wget \
    dnsutils \
    jq \
    tree \
    neovim \
    direnv \
    postgresql-client

# Tools commonly invoked by AI coding agents. Pinned here so they are always
# present regardless of what the base image ships. See README.md
# ("apt packages") for the per-package breakdown. fd-find/bat install under
# Debian-specific binary names (fdfind/batcat); the symlinks expose fd/bat.
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ripgrep \
    fd-find \
    bat \
    shellcheck \
    universal-ctags \
    patch \
    patchutils \
    miller \
    csvkit \
    httpie \
    netcat-openbsd \
    socat \
    lsof \
    file \
    moreutils \
    ncdu \
    strace \
    rsync && \
    ln -s "$(command -v fdfind)" /usr/local/bin/fd && \
    ln -s "$(command -v batcat)" /usr/local/bin/bat

# mise: polyglot runtime + tool manager. Installs node/python and the pinned
# release binaries (yq, starship, git-delta, just, terraform, …) in later steps
# and layers, replacing the old per-tool installers. extrepo is the Debian-blessed
# way to enable the upstream apt repo; it (and its deps) are dropped afterwards.
# https://github.com/jdx/mise/blob/main/docs/mise-cookbook/docker.md
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends extrepo \
    && extrepo enable mise \
    && apt-get remove -y --auto-remove extrepo \
    && apt-get update \
    && apt-get install -y --no-install-recommends mise build-essential

# mise data + config live outside $HOME (like NPM_CONFIG_PREFIX below) so the
# baked-in tools and version pins are not shadowed by the devcontainer's $HOME
# volume mounts. Shims go on PATH so tools resolve in any shell without activation.
ENV MISE_DATA_DIR="/usr/local/share/mise"
ENV MISE_CONFIG_DIR="/usr/local/share/mise"
ENV PATH="/usr/local/share/mise/shims:$PATH"

# Ensure default node user has access to /usr/local/share (npm globals + mise data)
RUN mkdir -p /usr/local/share/npm-global /usr/local/share/mise && \
    chown -R $USERNAME:$USERNAME /usr/local/share

# mise's global config: the committed mise.toml is the single source of truth for
# every tool/language version across all layers. Each layer runs `mise install
# <subset>` and reads the pins from here. Bump a version by editing mise.toml.
COPY --chown=$USERNAME:$USERNAME mise.toml /usr/local/share/mise/config.toml

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# Create workspace and config directories and set permissions
RUN mkdir -p /workspace \
    /home/$USERNAME/.claude \
    /home/$USERNAME/.local/share/fish \
    /home/$USERNAME/.local/bin \
    /home/$USERNAME/.cursor-server && \
    chown -R $USERNAME:$USERNAME /workspace /home/$USERNAME/.claude /home/$USERNAME/.local \
    /home/$USERNAME/.cursor-server

WORKDIR /workspaces

# Image version stamp for home-dir initialization tracking (written before USER switch)
ARG IMAGE_VERSION
RUN echo "${IMAGE_VERSION:-unversioned}" > /opt/.devcontainer-version

# Sudo + optional login password for ad-hoc root installs (`sudo apt install …`).
# The official node image does not put `node` in the sudo group or set a password.
# Pass BuildKit secret `container_user_password` (avoid `--build-arg`: it can appear in
# `docker image history`). Omit the secret entirely if you do not need password sudo.
#
# Locally: `--secret id=container_user_password,src=./config/.sudo-password` (see Justfile)
# Strip CR/LF from the secret file so CRLF editors do not bake `\r` into the password hash.
# If omitted, sudo is unusable until a root-capable step sets one, e.g.:
#   docker exec -u root -it <container> passwd node
RUN --mount=type=secret,id=container_user_password,required=false \
    usermod -aG sudo "$USERNAME" && \
    if [ -s /run/secrets/container_user_password ]; then \
    PASSWORD="$(tr -d '\r\n' </run/secrets/container_user_password)" && \
    printf '%s:%s\n' "$USERNAME" "$PASSWORD" | chpasswd; \
    fi

# Drop to non-root user for runtime
USER $USERNAME

# Set the default editor and visual
ENV EDITOR="nvim"
ENV VISUAL="nvim"

# Add ~/.local/bin (downstream tooling layers install here) and the npm-global bin to PATH.
# NPM_CONFIG_PREFIX points to a system path so global npm installs land in
# /usr/local/share/npm-global/bin, outside $HOME and unaffected by the devcontainer volume mount.
ENV PATH="/home/$USERNAME/.local/bin:$PATH"
ENV NPM_CONFIG_PREFIX="/usr/local/share/npm-global"
ENV PATH="/usr/local/share/npm-global/bin:$PATH"

# Languages and package managers via mise (installed as $USERNAME so they land in
# the user-owned MISE_DATA_DIR). Versions come from mise.toml COPY'd above. Node
# brings its own npm, so the tooling layer's `npm install -g` and NPM_CONFIG_PREFIX
# above keep working through the mise shim. pnpm/yarn replace the old Corepack
# dance; yq and starship replace a binary download and a vendor script.
RUN mise install node pnpm yarn yq starship

# Copy user configurations
COPY --chown=$USERNAME:$USERNAME config/config.fish /home/$USERNAME/.config/fish/config.fish
COPY --chown=$USERNAME:$USERNAME config/.profile /home/$USERNAME/.profile
COPY --chown=$USERNAME:$USERNAME config/nvim/init.lua /home/$USERNAME/.config/nvim/init.lua

# SSH bootstrap (same logic for local and CI — no COPY of gitignored paths).
# BuildKit secret `ssh_config` is optional (`required=false`). When the secret is
# omitted or empty, we only seed known_hosts; when it has content (local file or
# GitHub Actions secret → secret-files), we install ~/.ssh/config without baking it
# into a layer. uid/gid must match USER_UID/USER_GID; ARG expansion is not allowed
# in --mount flags.
RUN --mount=type=secret,id=ssh_config,required=false,uid=${USER_UID},gid=${USER_GID} \
    mkdir -p /home/$USERNAME/.ssh && \
    ssh-keyscan github.com >> /home/$USERNAME/.ssh/known_hosts 2>/dev/null && \
    if [ -f /run/secrets/ssh_config ] && [ -s /run/secrets/ssh_config ]; then \
    cp /run/secrets/ssh_config /home/$USERNAME/.ssh/config && \
    chmod 600 /home/$USERNAME/.ssh/config; \
    fi

# Default command: fish login shell. Use CMD (not ENTRYPOINT) so devcontainer's
# compose `command:` (e.g. `sleep infinity`) replaces it cleanly. With ENTRYPOINT,
# the CMD would be passed as args to fish, breaking container startup.
CMD ["/usr/bin/fish", "-l"]
