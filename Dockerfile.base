# syntax=docker/dockerfile:1
# https://hub.docker.com/_/debian
# Debian 13 (trixie), the current stable release. Node no longer comes from the
# base image; mise installs it (and every other language runtime) below.
FROM debian:trixie-slim

# Pass timezone as build argument
ARG TZ
ENV TZ="$TZ"

# Username for the non-root user
ARG USERNAME=user
ARG USER_UID=1000
ARG USER_GID=1000

# Automatically set by BuildKit for multi-platform builds; used to scope apt caches per arch
ARG TARGETARCH

# The node image used to provide this user; on a plain Debian base we create it
# ourselves so the uid/gid the devcontainer expects (1000:1000) exists.
RUN groupadd --gid "$USER_GID" "$USERNAME" \
    && useradd --uid "$USER_UID" --gid "$USER_GID" --create-home --shell /bin/bash "$USERNAME"

# Minimal shell + OS baseline. Only what the base's own steps and shell need: the
# fish login shell, git/curl/ca-certificates/gnupg for repos and apt keyrings,
# openssh-client for the ssh-keyscan below, neovim/direnv/fzf for the shell, plus
# sudo/less/procps/unzip. The AI-agent CLI toolkit and other developer utilities
# live in Dockerfile.tooling so this layer stays a lean baseline.
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    less \
    git \
    procps \
    sudo \
    fzf \
    fish \
    unzip \
    ca-certificates \
    curl \
    gnupg \
    gnupg2 \
    neovim \
    direnv \
    tzdata \
    openssh-client

# mise: polyglot runtime + tool manager. Installs node/python and the pinned
# release binaries (yq, starship, git-delta, just, terraform, …) in later steps
# and layers. extrepo is the Debian-blessed way to enable the upstream apt repo;
# it (and its deps) are dropped afterwards.
# https://github.com/jdx/mise/blob/main/docs/mise-cookbook/docker.md
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends extrepo \
    && extrepo enable mise \
    && apt-get remove -y --auto-remove extrepo \
    && apt-get update \
    && apt-get install -y --no-install-recommends mise build-essential

# mise data + config live outside $HOME (like NPM_CONFIG_PREFIX below) so the
# baked-in tools and version pins are not shadowed by the devcontainer's $HOME
# volume mounts. Shims go on PATH so tools resolve in any shell without activation.
ENV MISE_DATA_DIR="/usr/local/share/mise"
ENV MISE_CONFIG_DIR="/usr/local/share/mise"
ENV PATH="/usr/local/share/mise/shims:$PATH"

# Ensure the unprivileged user has access to /usr/local/share (npm globals + mise data)
RUN mkdir -p /usr/local/share/npm-global /usr/local/share/mise && \
    chown -R $USERNAME:$USERNAME /usr/local/share

# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# Create workspace and config directories and set permissions
RUN mkdir -p /workspace \
    /home/$USERNAME/.claude \
    /home/$USERNAME/.local/share/fish \
    /home/$USERNAME/.local/bin \
    /home/$USERNAME/.cursor-server && \
    chown -R $USERNAME:$USERNAME /workspace /home/$USERNAME/.claude /home/$USERNAME/.local \
    /home/$USERNAME/.cursor-server

WORKDIR /workspaces

# Sudo for ad-hoc root installs (`sudo apt install …`). The user we created above is
# not in the sudo group by default. No password is baked in — nothing personal ships in the
# image. The password is seeded at runtime by entrypoint.sh from a root-only mounted file
# (see docker-compose + scripts/container/entrypoint.sh); this protects the container from
# a rogue agent, since the user can neither read the plaintext nor sudo without it.
RUN usermod -aG sudo "$USERNAME"

# Runtime entrypoint (generic, no personal data). Seeds user's sudo password from a
# root-only mount if present, then drops to user to run the compose command.
COPY --chmod=0755 scripts/container/entrypoint.sh /usr/local/bin/entrypoint.sh

# Drop to non-root user for runtime
USER $USERNAME

# Set the default editor and visual
ENV EDITOR="nvim"
ENV VISUAL="nvim"

# Add ~/.local/bin (downstream tooling layers install here) and the npm-global bin to PATH.
# NPM_CONFIG_PREFIX points to a system path so global npm installs land in
# /usr/local/share/npm-global/bin, outside $HOME and unaffected by the devcontainer volume mount.
ENV PATH="/home/$USERNAME/.local/bin:$PATH"
ENV NPM_CONFIG_PREFIX="/usr/local/share/npm-global"
ENV PATH="/usr/local/share/npm-global/bin:$PATH"

# /etc/profile hard-resets PATH for login shells before sourcing /etc/profile.d,
# so `bash -l` (and anything Claude spawns from it, since hooks run via sh) would
# lose the mise shims, npm-global and ~/.local/bin set above. Snapshot the image
# PATH into a drop-in, which /etc/profile sources after its reset. Must stay after
# the last ENV PATH line so it captures all of them. Needs a root flip: /etc is not
# writable by $USERNAME.
USER root
RUN printf 'export PATH="%s"\n' "$PATH" > /etc/profile.d/00-image-path.sh
USER $USERNAME

# mise's global config: the committed mise.toml is the single source of truth for
# every tool/language version across all layers. Each layer runs `mise install
# <subset>` and reads the pins from here. Bump a version by editing mise.toml. COPY'd
# late so a version bump invalidates as little of this layer, and nothing earlier, as possible.
COPY --chown=$USERNAME:$USERNAME mise.toml /usr/local/share/mise/config.toml

# Shell/prompt + data tooling via mise (installed as $USERNAME so they land in the
# user-owned MISE_DATA_DIR). Versions come from mise.toml COPY'd above. Node/pnpm/yarn
# now live in Dockerfile.node (the next layer); the NPM_CONFIG_PREFIX + PATH env above is
# declared here so it is already in place when that layer installs node.
RUN mise install yq starship

# Copy user configurations
COPY --chown=$USERNAME:$USERNAME config/config.fish /home/$USERNAME/.config/fish/config.fish
COPY --chown=$USERNAME:$USERNAME config/.profile /home/$USERNAME/.profile
COPY --chown=$USERNAME:$USERNAME config/nvim/init.lua /home/$USERNAME/.config/nvim/init.lua

# SSH bootstrap: seed known_hosts only. Your personal ~/.ssh/config and keys are
# injected at runtime via docker-compose.override.yml bind mounts (see the .example),
# never baked into a layer.
RUN mkdir -p /home/$USERNAME/.ssh && \
    ssh-keyscan github.com >> /home/$USERNAME/.ssh/known_hosts 2>/dev/null

# Image version stamp for home-dir initialization tracking. Written last (as root, via
# a brief USER flip) so the ever-changing IMAGE_VERSION only invalidates this tiny layer,
# leaving the apt/mise/config work above cached across version-only rebuilds.
ARG IMAGE_VERSION
USER root
RUN echo "${IMAGE_VERSION:-unversioned}" > /opt/.devcontainer-version
USER $USERNAME

# Default command: fish login shell. Use CMD (not ENTRYPOINT) so devcontainer's
# compose `command:` (e.g. `sleep infinity`) replaces it cleanly. With ENTRYPOINT,
# the CMD would be passed as args to fish, breaking container startup.
CMD ["/usr/bin/fish", "-l"]
