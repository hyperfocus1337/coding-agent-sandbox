{
  "name": "Coding Agent Sandbox",
  "image": "coding-agent-sandbox-devcontainer:6.0-trixie",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "yzhang.markdown-all-in-one",
        "takumii.markdowntable",
        "esbenp.prettier-vscode",
        "kahole.magit",
        "sleistner.vscode-fileutils",
        "google.gemini-cli-vscode-ide-companion",
        "oderwat.indent-rainbow",
        "mermaidchart.vscode-mermaid-chart",
        "ms-playwright.playwright",
        "zainchen.json",
        "meta.pyrefly",
        "ms-python.python",
        "ms-python.debugpy",
        "mechatroner.rainbow-csv",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "nefrob.vscode-just-syntax"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "fish": {
            "path": "fish"
          }
        }
      }
    }
  },
  "runArgs": ["--name", "coding-agent-sandbox-devcontainer"],
  "remoteUser": "node",
  "mounts": [
    "source=coding-agent-sandbox-claude-config,target=/home/node/.claude,type=volume",
    "source=coding-agent-sandbox-cursor-state,target=/home/node/.cursor-server,type=volume",
    "source=coding-agent-sandbox-shell-history,target=/home/node/.shell-history,type=volume",
    "source=${localEnv:HOME}/.claude/commands,target=/home/node/.claude/commands,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh/config,target=/home/node/.ssh/config,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh/hyperfocus-key,target=/home/node/.ssh/hyperfocus-key,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "HISTFILE": "/home/node/.shell-history/.bash_history",
    "WORKSPACE_FOLDER": "/workspace/${localWorkspaceFolderBasename}"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename},type=bind,consistency=delegated",
  "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",
  "initializeCommand": "mkdir -p ~/.claude/commands",
  "postStartCommand": {
    "tessl": "bash /home/node/scripts/agents/tessl.sh",
    "activate": "fish /home/node/scripts/system/activate.fish"
  }
}
