# syntax=docker/dockerfile:1
# Adds Python + uv on top of the tooling devcontainer image.
# Override BASE_IMAGE via `--build-arg` (Justfile/CI pin the tooling devcontainer).
ARG BASE_IMAGE=ghcr.io/hyperfocus1337/coding-agent-sandbox/devcontainer-tooling:latest
FROM ${BASE_IMAGE}

# Base image declares ARG USERNAME=node but does not export it as ENV, so re-declare here.
ARG USERNAME=node

# Automatically set by BuildKit for multi-platform builds; used to scope apt caches per arch.
ARG TARGETARCH

# apt install must run as root; base image ends as non-root.
USER root
RUN --mount=type=cache,target=/var/cache/apt,id=apt-cache-$TARGETARCH,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=apt-lists-$TARGETARCH,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv

# UV package manager (standalone binary)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

USER $USERNAME

# Land any future `uv tool install` calls in ~/.local/bin (writable by $USERNAME, already on PATH
# from the base image). Without this, uv's default can vary by version.
ENV UV_TOOL_BIN_DIR="/home/$USERNAME/.local/bin"
